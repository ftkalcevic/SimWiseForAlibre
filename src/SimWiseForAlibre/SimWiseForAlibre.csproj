<Project Sdk="Microsoft.NET.Sdk">

  <!-- Alibre Design 27 hosts the .NET Framework 4.8 runtime, so the add-on must target net48. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SimWiseForAlibre</AssemblyName>
    <RootNamespace>SimWiseForAlibre</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AlibreProgram Condition="'$(AlibreProgram)' == ''">C:\Program Files\Alibre Design 27.0.1.27039\Program</AlibreProgram>
  </PropertyGroup>

  <ItemGroup>
    <!-- Alibre's own interop assemblies: referenced, never copied (Alibre has loaded them already). -->
    <Reference Include="AlibreX">
      <HintPath>$(AlibreProgram)\AlibreX.dll</HintPath>
      <Private>false</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="AlibreAddOn">
      <HintPath>$(AlibreProgram)\AlibreAddOn.dll</HintPath>
      <Private>false</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <!-- SimWise's export library (SimWiseExport.dll, installed and registered by SimWise),
         imported by tools\MakeInterop.ps1 and embedded, so no interop DLL is installed. -->
    <Reference Include="Interop.SimWiseExportLib">
      <HintPath>..\..\lib\Interop.SimWiseExportLib.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </Reference>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <None Update="SimWiseForAlibre.adc" CopyToOutputDirectory="PreserveNewest" />
    <None Update="SimWiseForAlibre.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
